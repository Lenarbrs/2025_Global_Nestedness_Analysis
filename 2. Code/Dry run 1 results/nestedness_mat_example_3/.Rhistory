## ---- 10. Generate and save expected heatmap ----
plot_expected_heatmap(save_path = "expected_pvalue_heatmap.png")
## ---- 9. Expected Significance Heatmap Function (Fixed) ----
plot_expected_heatmap <- function(save_path = NULL) {
# Define your parameter space (replace with your actual levels)
interaction_rates <- c("0.005", "0.1")  # Replace with your levels
mutation_rates <- c("0.001", "0.01")    # Replace with your levels
quota_ratios <- c("0.2", "0.5") # Replace with your levels
num_items <- c("20", "40")               # Replace with your levels
gateway_thresholds <- c("0", "0.5", "1")  # Replace with your levels
appeal_means <- c("false", "0.1", "0.5", "0.9") # Replace with your levels
# Create all parameter combinations
param_grid <- expand.grid(
interaction_rate = interaction_rates,
mutation_rate = mutation_rates,
quota_ratio = quota_ratios,
num_items = num_items,
gateway_threshold = gateway_thresholds,
appeal_mean = appeal_means
)
# Define expected distribution of p-values under null hypothesis
p_categories <- c("<0.001", "<0.005", "<0.01", "<0.05", ">=0.05")
category_probs <- c(0.001, 0.004, 0.005, 0.040, 0.950)  # Cumulative: 0.001, 0.005, 0.01, 0.05, 1.0
# Assign p-categories based on expected probabilities
set.seed(123)  # For reproducibility
param_grid$p_category <- sample(
x = p_categories,
size = nrow(param_grid),
prob = category_probs,
replace = TRUE
)
# Convert to factor for proper ordering
param_grid$p_category <- factor(param_grid$p_category, levels = p_categories)
# Create custom labeller
custom_labeller <- labeller(
quota_ratio = function(value) paste("quota:", value),
appeal_mean = function(value) paste("appeal:", value),
num_items = function(value) paste("items:", value),
gateway_threshold = function(value) paste("gateway:", value),
.default = label_value
)
# Reverse factor levels for x and y axes to put high values at bottom-right
param_grid <- param_grid %>%
mutate(
interaction_rate = factor(interaction_rate, levels = rev(interaction_rates)),
mutation_rate = factor(mutation_rate, levels = rev(mutation_rates))
)
# Create the heatmap plot with red in bottom-right
p <- ggplot(param_grid, aes(x = interaction_rate, y = mutation_rate, fill = p_category)) +
geom_tile(color = "white", linewidth = 0.3) +
facet_grid(
rows = vars(appeal_mean, quota_ratio),
cols = vars(gateway_threshold, num_items),
labeller = custom_labeller
) +
scale_fill_brewer(
palette = "YlOrRd",
direction = -1,
drop = FALSE
) +
scale_x_discrete(expand = c(0, 0)) +
scale_y_discrete(expand = c(0, 0)) +
labs(
x = "Interaction Rate →",
y = "Mutation Rate →",
title = "Expected p-value Distribution by Chance",
subtitle = "Theoretical distribution under null hypothesis (uniform p-values)\nMost significant p-values positioned in bottom-right",
fill = "P-value Category"
) +
theme_bw(base_size = 11) +
theme(
axis.text.x = element_text(angle = 90, vjust = 0.5, hjust = 1),
strip.text = element_text(size = 8, margin = margin(2, 2, 2, 2)),
strip.background = element_rect(fill = "gray90"),
panel.spacing = unit(0.5, "lines"),
legend.position = "right",
plot.title = element_text(hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5)
) +
# Add visual cue for significance gradient
annotate("segment",
x = -Inf, xend = Inf, y = -Inf, yend = Inf,
color = "gray30", linetype = "dotted", alpha = 0.5) +
annotate("text",
x = length(interaction_rates),
y = 1,
label = "More Significant",
color = "darkred", size = 3, hjust = 1.1, vjust = -0.5)
# Save plot if path is provided
if (!is.null(save_path)) {
ggsave(save_path, plot = p, width = 12, height = 9, dpi = 300)
message("Saved expected heatmap to: ", save_path)
}
return(p)
}
## ---- 10. Generate and save expected heatmap ----
plot_expected_heatmap(save_path = "analysis plots v4/expected_pvalue_heatmap.png")
## ---- 9. Expected Significance Heatmap Function (Fixed) ----
