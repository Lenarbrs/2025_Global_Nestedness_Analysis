# 2) Read metadata (semicolon-delimited CSV)
metadata <- read_delim(
"meta-data-matrices_all.csv",
delim = ";",
col_types = cols(
Group           = col_character(),
File            = col_character(),
Rows            = col_double(),
Columns         = col_double(),
